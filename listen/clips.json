---
layout: null
permalink: /listen/clips.json
---
{%- comment -%}
Everything the listening feed needs: each episode's audio files ("u": [url, seconds] per part, from
_data/audio_sources.json; "a": its Spotify ids for the full-episode link) and faces, every clip (the headline
questions in front matter, id "slug.N", and the chapter questions in _data/chapter_questions.json,
id "slug.cN") with the span that answers it, and the themes of the home page's theme map. Where other
episodes talk about the same subject is in /listen/related.json, fetched after the first clip is on screen. Paths are root-relative so the feed works over http and https.
{%- endcomment -%}
{"episodes":{
{%- for post in site.posts -%}
{%- assign ep = site.data.episode_index | where: "slug", post.slug | first -%}
{%- assign audio = post.audio_url | split: "," -%}
{%- assign files = site.data.audio_sources[post.slug] | default: empty -%}
{%- comment -%}"r": who this episode is a first visit or the longest-awaited reunion (half a year or more) for, said in a line.{%- endcomment -%}
{%- assign bond = "" -%}{%- assign reunion = nil -%}{%- assign reunion_months = 5 -%}
{%- for comeback in ep.returns -%}
{%- assign bond_guest = site.actors[comeback.id] -%}
{%- if comeback.first -%}{%- assign bond = bond | append: " / " | append: bond_guest.name | append: "さん初登場" -%}
{%- elsif comeback.months > reunion_months -%}{%- assign reunion = comeback -%}{%- assign reunion_months = comeback.months -%}{%- endif -%}
{%- endfor -%}
{%- if reunion -%}{%- assign bond_guest = site.actors[reunion.id] -%}{%- capture reunion_text -%}{{ bond_guest.name }}さん、{{ reunion.gap }}の{{ reunion.count }}回目{%- endcapture -%}{%- assign bond = bond | append: " / " | append: reunion_text -%}{%- endif -%}
{%- assign bond = bond | remove_first: " / " -%}
{{ post.slug | jsonify }}:{"n":{{ ep.number | default: post.slug | jsonify }},"t":{{ ep.subtitle | default: post.title | jsonify }},"a":[{% for audio_id in audio %}{{ audio_id | strip | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],"u":{{ files | jsonify }},"g":[{% for guest_id in ep.guests limit:4 %}{% assign guest = site.actors[guest_id] %}[{{ guest.name | default: guest_id | jsonify }},{{ guest.image_url | default: "" | jsonify }}]{% unless forloop.last %},{% endunless %}{% endfor %}]{% if bond != "" %},"r":{{ bond | jsonify }}{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
},"clips":[
{%- assign first_clip = true -%}
{%- for post in site.posts -%}
{%- for question in post.questions -%}
{%- if question.time and question.end -%}
{%- unless first_clip %},{% endunless -%}
{%- assign first_clip = false -%}
{"i":{{ post.slug | append: "." | append: forloop.index | jsonify }},"s":{{ post.slug | jsonify }},"x":{{ question.text | jsonify }},"t":{{ question.time | jsonify }},"e":{{ question.end | jsonify }}{% if question.part %},"p":{{ question.part }}{% endif %},"h":1}
{%- endif -%}
{%- endfor -%}
{%- endfor -%}
{%- for pair in site.data.chapter_questions -%}
{%- assign slug = pair[0] -%}
{%- for question in pair[1] -%}
{%- unless question.hidden -%}
{%- unless first_clip %},{% endunless -%}
{%- assign first_clip = false -%}
{"i":{{ slug | append: ".c" | append: forloop.index | jsonify }},"s":{{ slug | jsonify }},"x":{{ question.text | jsonify }},"t":{{ question.time | jsonify }},"e":{{ question.end | jsonify }}{% if question.part %},"p":{{ question.part }}{% endif %},"c":{{ question.chapter | jsonify }}}
{%- endunless -%}
{%- endfor -%}
{%- endfor -%}
],"themes":[
{%- for theme in site.data.themes -%}
{"id":{{ theme.id | jsonify }},"label":{{ theme.label | jsonify }},"lead":{{ theme.lead | jsonify }},"emoji":{{ theme.emoji | jsonify }},"clips":{{ theme.clips | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
],"host":{{ site.actors.ark_B.image_url | jsonify }}}
